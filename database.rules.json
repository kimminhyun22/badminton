{
  "rules": {
    ".read": false,
    ".write": false,

    "live": {
      ".read": false,
      ".write": false,

      "$sessionId": {
        ".read": "$sessionId.matches(/^((checkin|rsvp)_[A-Z0-9]{6,12}|[A-Z0-9]{6})$/)",
        ".write": "$sessionId.matches(/^((checkin|rsvp)_[A-Z0-9]{6,12}|[A-Z0-9]{6})$/)",

        "session": {
          ".validate": "!data.exists() || !data.hasChild('officialInvite/tokenHash') || newData.child('officialInvite/tokenHash').val() === data.child('officialInvite/tokenHash').val()",
          "serverSessionId": {
            ".validate": "!newData.exists() || !data.exists() || newData.val() === data.val()"
          },
          "$other": {
            ".validate": true
          }
        },

        "requests": {
          "$requestId": {
            ".validate": "!newData.exists() || newData.hasChildren(['type'])",
            "$field": {
              ".validate": true
            }
          }
        },

        "party": {
          "$playerId": {
            ".validate": true
          }
        },

        "operator": {
          ".validate": true
        },

        "responses": {
          "$memberId": {
            ".validate": true
          }
        },

        "$other": {
          ".validate": true
        }
      }
    }
  }
}
